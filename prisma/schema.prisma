// Prisma schema — Datenmodell der Dienstplan-App
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum TimeEntrySource {
  CLOCK // per Stempeluhr erfasst
  MANUAL // manuell eingetragen
}

enum TimeEntryStatus {
  PENDING // offen – vom Mitarbeiter änderbar, wartet auf Bestätigung
  CONFIRMED // vom Admin bestätigt – für den Mitarbeiter gesperrt
}

enum AbsenceType {
  VACATION // Urlaub – reduziert den Jahresanspruch
  SICK // Krankheit
  OTHER // Sonstiges / unbezahlt
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String? // null, bis die Einladung angenommen wurde
  role         Role    @default(EMPLOYEE)
  active       Boolean @default(false)

  // Anstellung / Arbeitszeit
  weeklyHours         Float     @default(40)
  workDaysPerWeek     Int       @default(5)
  vacationDaysPerYear Float     @default(30)
  minBreakMinutes     Int       @default(0) // 0 = nur gesetzliche Pausenlogik
  employmentStart     DateTime?

  // Einladungs-Flow
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?

  timeEntries TimeEntry[]
  shifts      Shift[]
  absences    Absence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Abwesenheit (Urlaub, Krankheit, Sonstiges) über einen Zeitraum.
model Absence {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      AbsenceType
  startDate DateTime      @db.Date
  endDate   DateTime      @db.Date // einschließlich
  halfDay   Boolean       @default(false) // nur sinnvoll bei startDate == endDate
  status    AbsenceStatus @default(PENDING)
  note      String?
  decidedAt DateTime? // Zeitpunkt der Genehmigung/Ablehnung

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startDate])
  @@index([status])
}

/// Wiederverwendbare Schichtvorlage, z. B. "Früh 06:00–14:00".
model ShiftTemplate {
  id           String  @id @default(cuid())
  name         String // "Frühschicht"
  shortLabel   String // "Früh" – kompakte Anzeige im Plan
  startMinutes Int // Minuten ab Mitternacht, 360 = 06:00
  endMinutes   Int // 840 = 14:00; <= startMinutes bedeutet über Mitternacht
  breakMinutes Int? // geplante Pause (optional)
  color        String  @default("#64748b")
  active       Boolean @default(true)
  sortOrder    Int     @default(0)

  shifts    Shift[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Einem Mitarbeiter an einem Tag zugewiesene Schicht.
model Shift {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  templateId String?
  template   ShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Snapshot der Werte – spätere Vorlagenänderungen wirken nicht rückwirkend
  startMinutes Int
  endMinutes   Int
  breakMinutes Int?
  label        String
  color        String
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([userId, date])
}

model TimeEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  start        DateTime
  end          DateTime? // null = läuft noch (eingestempelt)
  breakMinutes Int? // null = automatisch (gesetzlich + MA-Mindestwert)
  note         String?

  source         TimeEntrySource @default(MANUAL)
  status         TimeEntryStatus @default(PENDING)
  correctionNote String? // Begründung des Mitarbeiters bei einer Korrektur

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, start])
  @@index([status])
}
