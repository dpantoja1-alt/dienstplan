# --- Datenbank (Neon PostgreSQL) ---
# Aus dem Neon-Dashboard: "Connection string" (pooled), mit ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# --- Auth.js ---
# Zufalls-Secret erzeugen: npx auth secret   (oder: openssl rand -base64 33)
AUTH_SECRET="hier-ein-langes-zufalls-secret"

# --- E-Mail-Versand (optional, für Einladungs-Mails) ---
# API-Key von https://resend.com  (ohne Key wird der Einladungslink nur im Admin-Bereich angezeigt)
RESEND_API_KEY=""
# Absender – erst nach Domain-Verifizierung bei Resend änderbar; sonst weglassen (Default: onboarding@resend.dev)
EMAIL_FROM="Dienstplan <onboarding@resend.dev>"

# --- Erstes Admin-Konto (nur fuer `npm run db:seed`) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="bitte-aendern"
ADMIN_NAME="Daniel Pantoja"
